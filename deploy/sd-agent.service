[Unit]
Description=SD Agent web app (chat + gallery + PWA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/opt/sd-agent
# ---- set your app password here ----
Environment=AGENT_PASSWORD=CHANGE_ME
Environment=PORT=8000
ExecStart=/opt/sd-agent/.venv/bin/python server.py --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/sd-agent

[Install]
WantedBy=multi-user.target
